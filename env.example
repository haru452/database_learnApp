# Vite / Next.js に組み込むときの環境変数のひな形。
# このファイルを ".env.local" にコピーして、値を書き換える (".env.local" は GitHub に上げない)。
# Vercel には、同じ名前と値を、ダッシュボードの Settings > Environment Variables に登録する。
#
# ブラウザに置いてよいのは、Project URL と anon キー (publishable key) だけ。
# service_role / secret キーは、ここに書かない。

# --- Vite ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Next.js ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
